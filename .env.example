# Copy to .env and fill in. See README.md and docs/ for each MODE.

# How the server is reached:
#   cloudflare  Cloudflare Tunnel, no open ports            -> docs/cloudflare-tunnel.md
#   public      public IP + any DNS provider, Caddy + Let's Encrypt -> docs/public-server.md
#   local       this machine (*.localhost) or your LAN only -> docs/local.md
#   proxy       your own nginx/Traefik/... in front         -> docs/reverse-proxy.md
MODE=cloudflare

# The part after the colon in user IDs: @alice:example.com
# !! This can NEVER be changed later without wiping the server. !!
# If the bare domain already hosts a website elsewhere, set this to the same
# value as MATRIX_HOST instead.
SERVER_NAME=example.com

# Hostname where Synapse (the homeserver) is reachable.
MATRIX_HOST=matrix.example.com

# Hostname where the Element web client is reachable.
ELEMENT_HOST=chat.example.com

# false (recommended): people can only sign up with an invite token from
#   `./matrix.sh invite`, or you create accounts with `./matrix.sh adduser`.
# true: anyone who can reach the server can sign up, no token needed.
ENABLE_REGISTRATION=false

# false: a private island, only @...:SERVER_NAME accounts can talk to each other.
# true: talk to matrix.org and every other Matrix server (needs a public MODE).
ENABLE_FEDERATION=false

# Largest file users can upload. Default 95M with MODE=cloudflare (its limit is
# 100 MB per request), 200M otherwise.
#MAX_UPLOAD_SIZE=

# --- MODE=cloudflare -------------------------------------------------------
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- MODE=public -----------------------------------------------------------
# Let's Encrypt uses this to warn you about expiring/failed certificates.
ACME_EMAIL=

# --- MODE=public / MODE=local ----------------------------------------------
# Host ports Caddy listens on. MODE=public needs the defaults (80 and 443).
#HTTP_PORT=80
#HTTPS_PORT=443

# --- MODE=proxy ------------------------------------------------------------
# Where synapse (8008), element and wellknown are published for your proxy.
# Use the server's LAN IP if the proxy runs on another machine.
#BIND_ADDRESS=127.0.0.1
#ELEMENT_PORT=8080
#WELLKNOWN_PORT=8081
